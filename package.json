{
  "name": "gndec-compass-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-ready student campus companion for GNDEC Ludhiana",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "wrangler": "^4.40.0"
  }
}
